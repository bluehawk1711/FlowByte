# Flowbyte Mobile (Expo) — environment template.
# Copy to apps/mobile/.env. No secrets here — the API owns secrets.

# Overrides the default API URL (http://localhost:3001).
# When running on a real device, use your machine's LAN IP, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
