# Flowbyte API — environment template.
# Copy to apps/api/.env and fill in real values. NEVER commit real values.

# PostgreSQL
DATABASE_URL=postgres://flowbyte:flowbyte@localhost:5432/flowbyte

# Storage — local (dev) or backblaze (prod)
STORAGE_PROVIDER=local
# Local storage root (relative to apps/api, e.g. ../../storage)
LOCAL_STORAGE_PATH=../../storage

# Backblaze B2 (only needed when STORAGE_PROVIDER=backblaze)
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional Upstash Redis (read-through cache — Phase 11). Both must be set to
# enable; when unset the API runs without caching. REST URL + token from
# console.upstash.com (Redis → your database → REST API). These are the
# canonical Upstash env var names (@upstash/redis `Redis.fromEnv()` reads them).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Drive (optional — enables cloud storage)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3001/api/storage/google-drive/callback

# API
PORT=3001
# Comma-separated allowed origins for CORS.
# Defaults to localhost dev URLs when unset.
# Production example: CORS_ORIGINS=https://flowbyte.onrender.com,tauri://localhost,http://localhost:1420
# - tauri://localhost = Tauri 2 desktop app (production builds)
# - http://localhost:1420 = Vite dev server (local development)
CORS_ORIGINS=
