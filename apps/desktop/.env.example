# Flowbyte Desktop (Tauri + Vite) — environment template.
# Copy to apps/desktop/.env. No secrets here — the API owns secrets.

# Overrides the default API URL (http://localhost:3001) used by the app at runtime.
# Points at the Flowbyte API root (no /api suffix needed).
VITE_API_URL=http://localhost:3001

# Dev-only: set to your LAN IP when testing on a physical device / VM.
# TAURI_DEV_HOST=
